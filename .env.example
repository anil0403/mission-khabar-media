# Copy to .env and fill in. Never commit .env.

# Payload
PAYLOAD_SECRET=            # long random string: openssl rand -hex 32

# Database — Neon Postgres
DATABASE_URL=              # pooled URL (host has -pooler), ends with ?sslmode=require
DATABASE_URL_DIRECT=       # direct (non-pooled) URL, used by `npm run migrate` only

# Images — Cloudinary (leave empty in local dev to store uploads on disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (leave empty in local dev to print emails to the console)
RESEND_API_KEY=            # re_...
EMAIL_FROM=onboarding@resend.dev          # → no-reply@missionkhabarmedia.com.np after domain verify
EMAIL_FROM_NAME=Mission Khabar Media
CONTACT_TO_EMAIL=          # where contact-form messages go

# Reader login — Better Auth
BETTER_AUTH_SECRET=        # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000        # → https://missionkhabarmedia.com.np
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # → https://missionkhabarmedia.com.np
NEXT_PUBLIC_INDEXABLE=false                  # true only on the production VPS (Vercel uses VERCEL_ENV)
NEXT_PUBLIC_GA_ID=                           # G-XXXXXXX, optional
YOUTUBE_CHANNEL_ID=UCgdD5Xy5HMH0dFqmUne7OLw   # @MissionKhabarMedia
